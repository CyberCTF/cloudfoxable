# Isoloom: local state of the generated outputs (the generated files themselves are committed)
.isoloom/**/.vagrant/
.isoloom/**/.terraform/
.isoloom/**/.terraform.lock.hcl
.isoloom/**/*.tfstate*
.isoloom/**/.isoloom-project*.tgz
# Terraform run on the module in place (`terraform -chdir`): its lock file, and any local state
**/.terraform.lock.hcl
**/.terraform/
**/*.tfstate*
**/*.tfvars
!.isoloom/**/terraform.tfvars.json
# Generated by a run: upstream's Lambda archives
app/aws/challenges/*/data/lambda/lambda_function.zip
app/aws/challenges/Middle/data/lambda/*/lambda_function.zip
